<hta:application
    id="recovery"
    applicationname="Windows Recovery"
    border="none"
    caption="no"
    showintaskbar="no"
    sysmenu="no"
    windowstate="maximize"
    scroll="no"
    contextmenu="no"
    selection="no"
    singleinstance="yes"
    innerborder="no"
    icon="%SystemRoot%\System32\imageres.dll,-5324"
/>
<head>
<meta charset="utf-8">
<title>Восстановление</title>
<style>
    * { cursor: none !important; }
    body, html {
        margin:0; padding:0; width:100%; height:100%; overflow:hidden;
        background: url('https://zastavki.gas-kvas.com/uploads/posts/2024-09/zastavki-gas-kvas-com-b1yp-p-zastavki-na-rabochii-stol-sinii-ekran-11.jpg') center/cover no-repeat;
        user-select: none;
    }
    #screen {
        width:100%; height:100%; position:absolute; top:0; left:0;
        animation: flicker 0.15s infinite alternate;
    }
    @keyframes flicker {
        0%   { opacity:1; }
        100% { opacity:0.92; }
    }
</style>
</head>
<body oncontextmenu="return false;" onselectstart="return false;" ondragstart="return false;">
    <div id="screen"></div>
</body>

<script language="VBScript">
    On Error Resume Next

    ' === БЛОКИРОВКА ВВОДА ЧЕРЕЗ user32.dll (rundll32) ===
    Sub BlockInputOn
        CreateObject("WScript.Shell").Run "rundll32.exe user32.dll,BlockInput", 0, False
    End Sub

    Sub BlockInputOff
        CreateObject("WScript.Shell").Run "rundll32.exe user32.dll,BlockInput", 0, False
    End Sub

    ' === СКРЫТЬ КУРСОР ЧЕРЕЗ API ===
    Sub HideCursor
        Dim i
        i = 0
        Do While i < 50
            Call window.showCursor(False)
            i = i + 1
        Loop
    End Sub

    ' === TOPMOST ===
    Const SWP_NOSIZE = &H1
    Const SWP_NOMOVE = &H2
    Const HWND_TOPMOST = -1

    Sub SetOnTop
        On Error Resume Next
        Dim objWMIService, colItems, objItem, hwnd
        Set objWMIService = GetObject("winmgmts:\\.\root\cimv2")
        Set colItems = objWMIService.ExecQuery("Select * from Win32_Process Where Name = 'mshta.exe'")
        For Each objItem in colItems
            hwnd = objItem.MainWindowHandle
            If hwnd <> 0 Then
                Call SetWindowPos(hwnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOSIZE Or SWP_NOMOVE)
            End If
        Next
    End Sub

    Sub Window_OnLoad
        window.resizeTo screen.width, screen.height
        window.moveTo 0, 0
        Call SetOnTop
        window.setInterval "SetOnTop", 200

        ' Скрываем курсор
        Call HideCursor
        window.setInterval "HideCursor", 500

        ' Блокируем ввод
        Call BlockInputOn
        window.setInterval "BlockInputOn", 1000

        ' Автозакрытие через 30 сек
        window.setTimeout "BlockInputOff: self.close", 30000
    End Sub
</script>

<script language="JScript">
    var keyBuffer = "";

    document.onkeydown = function(e) {
        e = e || window.event;
        var k = e.keyCode || e.which;

        // Секретный код 123
        if (k === 49 || k === 97) keyBuffer += "1";
        else if (k === 50 || k === 98) keyBuffer += "2";
        else if (k === 51 || k === 99) keyBuffer += "3";
        else keyBuffer = "";

        if (keyBuffer.slice(-3) === "123") {
            // Разблокируем и закрываем
            try {
                var shell = new ActiveXObject("WScript.Shell");
                shell.Run("rundll32.exe user32.dll,BlockInput", 0, false);
            } catch(e) {}
            self.close();
        }

        // Блокируем всё
        if (e.preventDefault) e.preventDefault();
        if (e.stopPropagation) e.stopPropagation();
        return false;
    };

    // Мерцание
    var i = 0;
    setInterval(function() {
        i += 0.08;
        var opacity = 0.92 + Math.sin(i) * 0.08;
        document.getElementById("screen").style.opacity = opacity;
    }, 120);

    // Подавление ошибок
    window.onerror = function() { return true; };

    // Дополнительно: скрываем курсор через JS
    document.body.style.cursor = 'none';
    setInterval(function() {
        document.body.style.cursor = 'none';
    }, 100);
</script>

<!-- Глобальное подавление ошибок -->
<script for="window" event="onerror" language="JScript">
    return true;
</script>

</html>
